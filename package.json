{
  "name": "catchup-clerk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "MODE=live node --env-file-if-exists=.env src/server.js",
    "demo": "MODE=demo PORT=3101 node --env-file-if-exists=.env src/server.js",
    "test": "node --test",
    "fixture": "node scripts/make-demo-fixture.js",
    "assets": "node scripts/build-assets.js",
    "worker:dev": "npm run assets && npx wrangler dev",
    "deploy": "npm run assets && npx wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.154.0"
  }
}
